+    public var showAppBadge: Bool {
+        // The minis are left out as they were while they matched the iPhone X by screen size.
+        switch self {
+        case .iPhoneX, .iPhone12Mini, .iPhone13Mini:
+            return false
+        default:
+            return self.hasTopNotch || self.hasDynamicIsland
+        }
+    }
