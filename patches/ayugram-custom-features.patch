+public final class AyuSupportersManager {
+    public static let shared = AyuSupportersManager()
+
+    private let lock = NSLock()
+    private var supporters: Set<Int64> = []
+    private var developers: Set<Int64> = [
+        749218, 139303278, 168769611, 668557709, 880708503, 963080346,
+        1282540315, 1348136086, 1374434073, 1752394339, 1773117711, 2135966128,
+        5079320635, 5118627360, 5184725450, 5330087923, 5800413909, 6007644928,
+        7380551229, 7738913005, 7818249287, 8083933640
+    ]
+    private var lastFetchTimestamp: TimeInterval = 0
+    private var isFetching = false
+
+    private init() {
+        self.loadFromDisk()
+        self.refreshIfNeeded()
+    }
+
+    public func isSupporter(peerId: Int64) -> Bool {
+        self.lock.lock()
+        defer { self.lock.unlock() }
+        return self.supporters.contains(peerId) || self.developers.contains(peerId)
+    }
+
+    public func isDeveloper(peerId: Int64) -> Bool {
+        self.lock.lock()
+        defer { self.lock.unlock() }
+        return self.developers.contains(peerId)
+    }
+
+    private var cacheFileURL: URL? {
+        guard let appSupport = FileManager.default.urls(for: .applicationSupportDirectory, in: .userDomainMask).first else {
+            return nil
+        }
+        let dir = appSupport.appendingPathComponent("AyuGram", isDirectory: true)
+        if !FileManager.default.fileExists(atPath: dir.path) {
+            try? FileManager.default.createDirectory(at: dir, withIntermediateDirectories: true)
+        }
+        return dir.appendingPathComponent("supporters.json")
+    }
+
+    private func loadFromDisk() {
+        guard let url = self.cacheFileURL, let data = try? Data(contentsOf: url) else { return }
+        self.parsePayload(data: data)
+    }
+
+    private func saveToDisk(data: Data) {
+        guard let url = self.cacheFileURL else { return }
+        try? data.write(to: url, options: .atomic)
+    }
+
+    private func parsePayload(data: Data) {
+        guard let json = try? JSONSerialization.jsonObject(with: data) as? [String: Any] else { return }
+        var newSupporters = Set<Int64>()
+        if let list = json["supporters"] as? [Any] {
+            for item in list {
+                if let num = item as? NSNumber {
+                    newSupporters.insert(num.int64Value)
+                }
+            }
+        }
+        var newDevelopers = Set<Int64>()
+        if let list = json["developers"] as? [Any] {
+            for item in list {
+                if let num = item as? NSNumber {
+                    newDevelopers.insert(num.int64Value)
+                }
+            }
+        }
+
+        self.lock.lock()
+        if !newSupporters.isEmpty {
+            self.supporters = newSupporters
+        }
+        if !newDevelopers.isEmpty {
+            self.developers.formUnion(newDevelopers)
+        }
+        self.lock.unlock()
+    }
+
+    public func refreshIfNeeded() {
+        let now = Date().timeIntervalSince1970
+        self.lock.lock()
+        guard !self.isFetching && (now - self.lastFetchTimestamp > 3600.0) else {
+            self.lock.unlock()
+            return
+        }
+        self.isFetching = true
+        self.lock.unlock()
+
+        self.fetchFromURL(urlString: "https://update.ayugram.one/rc/current/desktop2") { [weak self] success in
+            if !success {
+                self?.fetchFromURL(urlString: "https://api.exteragram.app/api/v1/profiles/compact") { _ in
+                    self?.lock.lock()
+                    self?.isFetching = false
+                    self?.lastFetchTimestamp = Date().timeIntervalSince1970
+                    self?.lock.unlock()
+                }
+            } else {
+                self?.lock.lock()
+                self?.isFetching = false
+                self?.lastFetchTimestamp = Date().timeIntervalSince1970
+                self?.lock.unlock()
+            }
+        }
+    }
+
+    private func fetchFromURL(urlString: String, completion: @escaping (Bool) -> Void) {
+        guard let url = URL(string: urlString) else {
+            completion(false)
+            return
+        }
+        var request = URLRequest(url: url)
+        request.timeoutInterval = 15.0
+        URLSession.shared.dataTask(with: request) { [weak self] data, response, error in
+            guard let data = data, error == nil,
+                  let httpResponse = response as? HTTPURLResponse, (200...299).contains(httpResponse.statusCode) else {
+                completion(false)
+                return
+            }
+            self?.parsePayload(data: data)
+            self?.saveToDisk(data: data)
+            completion(true)
+        }.resume()
+    }
+}
