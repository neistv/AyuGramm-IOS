+    public var hasDynamicIsland: Bool {
+        switch self {
+            case .iPhone14Pro, .iPhone14ProZoomed, .iPhone14ProMax, .iPhone14ProMaxZoomed, .iPhone16Pro, .iPhone16ProMax, .iPhoneAir, .iPhone18Pro, .iPhone18ProMax:
+                return true
+            default:
+                return false
+        }
+    }
