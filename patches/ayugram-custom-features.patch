+public final class AyuSupportersManager {
+    public static let shared = AyuSupportersManager()
+    private let lock = NSLock()
+    private var supporters: Set<Int64> = [
+        749218, 139303278, 168769611, 668557709, 880708503, 963080346,
+        1282540315, 1348136086, 1374434073, 1752394339, 1773117711, 2135966128,
+        5079320635, 5118627360, 5184725450, 5330087923, 5800413909, 6007644928,
+        7380551229, 7738913005, 7818249287, 8083933640
+    ]
+    private var isRefreshing = false
+
+    private init() {
+        self.loadCached()
+        self.refresh()
+    }
+
+    public func isSupporter(peerId: Int64) -> Bool {
+        self.lock.lock()
+        defer { self.lock.unlock() }
+        return self.supporters.contains(peerId)
+    }
+
+    private var cacheUrl: URL? {
+        FileManager.default.urls(for: .applicationSupportDirectory, in: .userDomainMask).first?
+            .appendingPathComponent("AyuGram", isDirectory: true)
+            .appendingPathComponent("supporters.json")
+    }
+
+    private func loadCached() {
+        guard let url = self.cacheUrl, let data = try? Data(contentsOf: url) else { return }
+        self.parse(data: data)
+    }
+
+    private func refresh() {
+        guard !self.isRefreshing else { return }
+        self.isRefreshing = true
+        let endpoints = [
+            "https://update.ayugram.one/rc/current/desktop2",
+            "https://api.exteragram.app/api/v1/profiles/compact"
+        ]
+        self.tryFetch(endpoints: endpoints, index: 0)
+    }
+
+    private func tryFetch(endpoints: [String], index: Int) {
+        guard index < endpoints.count, let url = URL(string: endpoints[index]) else {
+            self.isRefreshing = false
+            return
+        }
+        var request = URLRequest(url: url)
+        request.timeoutInterval = 15.0
+        let session = URLSession(configuration: .ephemeral)
+        session.dataTask(with: request) { [weak self] data, response, error in
+            guard let self else { return }
+            if let http = response as? HTTPURLResponse, http.statusCode == 200, let data {
+                self.parse(data: data)
+                if let cacheUrl = self.cacheUrl {
+                    try? FileManager.default.createDirectory(at: cacheUrl.deletingLastPathComponent(), withIntermediateDirectories: true)
+                    try? data.write(to: cacheUrl, options: .atomic)
+                }
+                self.isRefreshing = false
+            } else {
+                self.tryFetch(endpoints: endpoints, index: index + 1)
+            }
+        }.resume()
+    }
+
+    private func parse(data: Data) {
+        guard let json = try? JSONSerialization.jsonObject(with: data) as? [String: Any] else { return }
+        var ids = Set<Int64>()
+        if let dev = json["developers"] as? [NSNumber] {
+            for n in dev { ids.insert(n.int64Value) }
+        }
+        if let sup = json["supporters"] as? [NSNumber] {
+            for n in sup { ids.insert(n.int64Value) }
+        }
+        if let off = json["officialChannels"] as? [NSNumber] {
+            for n in off { ids.insert(n.int64Value) }
+        }
+        if !ids.isEmpty {
+            self.lock.lock()
+            self.supporters.formUnion(ids)
+            self.lock.unlock()
+        }
+    }
+}
