+/// The account's own peer as this client draws it with Local Premium and the local status.
+func ayuLocalPremiumPreviewPeer(_ peer: EnginePeer, settings: AyuAdvancedSettings) -> EnginePeer {
+    guard case let .user(user) = peer else { return peer }
+    var updated = user
+    if settings.localPremium || settings.localEmojiStatusEnabled {
+        updated = updated.withUpdatedFlags(user.flags.union(.isPremium))
+    }
+    if let fileId = settings.localStatusFileId {
+        updated = updated.withUpdatedEmojiStatus(PeerEmojiStatus(content: .emoji(fileId: fileId), expirationDate: nil))
+    }
+    return .user(updated)
+}
