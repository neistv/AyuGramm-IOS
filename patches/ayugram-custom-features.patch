+    case iPhone13
+    case iPhone13Pro
+    case iPhone13ProMax
+    case iPhone14Pro
+    case iPhone14ProZoomed
+    case iPhone14ProMax
+    case iPhone14ProMaxZoomed
+    case iPhone16Pro
+    case iPhone16ProMax
+    case iPhoneAir
+    case iPhoneDuo
