+private func ayuAutoReplyQuote(for message: Message, appConfig: AppConfiguration) -> EngineMessageReplyQuote? {
+    let nsText = message.text as NSString
+    guard nsText.length > 0 else {
+        return nil
+    }
+    let maxLength = quoteMaxLength(appConfig: appConfig)
+    let range = NSRange(location: 0, length: min(nsText.length, maxLength))
+    let text = nsText.substring(with: range)
+    var replyMedia: Media?
+    for media in message.media {
+        switch media {
+        case _ as TelegramMediaImage, _ as TelegramMediaFile:
+            replyMedia = media
+        default:
+            break
+        }
+    }
+    return EngineMessageReplyQuote(
+        text: text,
+        offset: nil,
+        entities: messageTextEntitiesInRange(
+            entities: message.textEntitiesAttribute?.entities ?? [],
+            range: range,
+            onlyQuoteable: true
+        ),
+        media: replyMedia
+    )
+}
